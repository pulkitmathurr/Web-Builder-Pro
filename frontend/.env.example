# Base URL of the deployed backend API, including the /api prefix.
# Local dev: leave unset — axios.js falls back to http://localhost:5000/api
# Production (Vercel): set to your Render backend URL, e.g.
# VITE_API_URL=https://school-saas-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
