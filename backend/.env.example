# Server
PORT=5000
NODE_ENV=development

# Database
# Local dev (XAMPP): DB_HOST=localhost, DB_PORT=3306, no SSL needed.
# Production (Aiven): use the host/port/user/password from your Aiven service
# overview page, e.g. DB_HOST=mysql-xxxxxxxx-xxxxx.b.aivencloud.com, DB_PORT=13494.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=db_school_saas
DB_PORT=3306

# Aiven requires SSL. Download the ca.pem from your Aiven console, commit it to
# backend/ca.pem (NOT gitignored — see .gitignore), and leave this unset to use
# that default path, or point it elsewhere with a path relative to backend/.
# Local XAMPP MySQL has no ca.pem, so SSL is skipped automatically when the
# file isn't found — no need to unset this for local dev.
DB_SSL_CA_PATH=ca.pem

# JWT — use long random strings in production, never reuse the example values
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary — get these from your Cloudinary dashboard (cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL — must match exactly where the frontend is running/deployed
# (currently informational only — CORS is temporarily set to allow all origins
# in app.js until the Vercel URL is known; see the TODO there)
FRONTEND_URL=http://localhost:5173
